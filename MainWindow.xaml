<Window x:Class="LazarevFirewall.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="Lazarev Firewall" Width="1152" Height="648" MinWidth="760" MinHeight="428" Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="12" WindowStartupLocation="Manual" WindowStyle="None" ResizeMode="CanResize">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="36" CornerRadius="8" GlassFrameThickness="0" ResizeBorderThickness="6" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
 <Border Margin="6" Background="{DynamicResource ShellBrush}" BorderBrush="{DynamicResource ShellBorderBrush}" BorderThickness="1" CornerRadius="8">
  <Grid ClipToBounds="True">
   <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="42"/><RowDefinition Height="40"/><RowDefinition Height="*"/><RowDefinition Height="24"/></Grid.RowDefinitions>
   <Border Grid.Row="0" Background="{DynamicResource TitleBarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" shell:WindowChrome.IsHitTestVisibleInChrome="True" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="132"/></Grid.ColumnDefinitions>
     <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0"><TextBlock Text="&#x1F6E1;" Foreground="{DynamicResource BlueBrush}" FontSize="15" Margin="0,0,8,0"/><TextBlock Text="Lazarev Firewall" FontWeight="SemiBold"/><TextBlock Text=" &#x2014; Preview Build" Foreground="{DynamicResource MutedBrush}" FontSize="11"/></StackPanel>
     <Border Grid.Column="1" Background="{DynamicResource BannerBrush}" BorderBrush="{DynamicResource AmberBrush}" BorderThickness="1" CornerRadius="4" Padding="10,3" Margin="0,5" shell:WindowChrome.IsHitTestVisibleInChrome="False"><StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="{DynamicResource AmberBrush}" VerticalAlignment="Center" Margin="0,0,7,0"/><TextBlock Text="Preview mode &#x2014; firewall engine is not running" Foreground="{DynamicResource AmberBrush}" FontWeight="Medium" FontSize="11"/></StackPanel></Border>
     <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right"><Button Width="44" Height="35" Content="&#x2014;" Background="Transparent" BorderThickness="0" FontSize="13" Click="Minimize_Click"/><Button Width="44" Height="35" Content="&#x25A1;" Background="Transparent" BorderThickness="0" FontSize="12" Click="Maximize_Click"/><Button Width="44" Height="35" Content="&#x00D7;" Background="Transparent" BorderThickness="0" FontSize="17" Click="Close_Click"/></StackPanel>
    </Grid>
   </Border>
   <Grid Grid.Row="1" Background="{DynamicResource ShellBrush}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,12,0"><TextBlock Text="STATE:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/><ComboBox Width="184" Height="28" SelectedIndex="0"><ComboBoxItem Content="&#x1F6E1; Normal / Default deny"/></ComboBox></StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="All" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource MutedBrush}"/><Border Background="{DynamicResource SelectionBrush}" CornerRadius="4" Margin="3,0"><Button Content="Programs   6" Foreground="{DynamicResource BlueBrush}" BorderThickness="0" Background="Transparent" FontWeight="Medium"/></Border><Button Content="Services   14" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource MutedBrush}"/><Button Content="Microsoft Apps   12" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource MutedBrush}"/></StackPanel>
    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0"><TextBlock Text="Inbound: " Foreground="{DynamicResource MutedBrush}" FontSize="11"/><TextBlock Text="0.0 KB/s" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" FontSize="11" Margin="0,0,12,0"/><TextBlock Text="Outbound: " Foreground="{DynamicResource MutedBrush}" FontSize="11"/><TextBlock Text="14.8 KB/s" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" FontSize="11" Margin="0,0,12,0"/><TextBlock Text="|" Foreground="{DynamicResource BorderBrush}"/><TextBlock Text="Filtered: " Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="10,0,0,0"/><TextBlock Text="1,402 pkts" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" FontSize="11"/><Button Content="&#x2699;" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource MutedBrush}" FontSize="15" Padding="8,3"/></StackPanel>
   </Grid>
   <Grid Grid.Row="2" Background="{DynamicResource SurfaceBrush}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0"><Button Content="&#xFF0B; Add  &#x25BE;" Background="{DynamicResource BlueBrush}" Foreground="White" BorderBrush="{DynamicResource BlueBrush}"/><Button Content="&#x2713;  Allow" Foreground="{DynamicResource GreenBrush}" BorderBrush="#6622C55E" Background="#1A22C55E" Margin="5,0"/><Button Content="&#x2715;  Block" Foreground="{DynamicResource RedBrush}" BorderBrush="#66EF4444" Background="#1AEF4444"/><Button Content="&#x1F5D1;  Remove" Foreground="{DynamicResource MutedBrush}" BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource SurfaceBrush}" Margin="5,0"/></StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0"><TextBox Width="256" Height="28" Text="Search applications, paths, remote IP" Foreground="{DynamicResource MutedBrush}"/><ComboBox Width="132" Height="28" Margin="8,0,0,0" SelectedIndex="0"><ComboBoxItem Content="All statuses"/></ComboBox></StackPanel>
   </Grid>
   <Grid Grid.Row="3" Background="{DynamicResource TableBrush}">
    <Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid.ColumnDefinitions><ColumnDefinition Width="19*"/><ColumnDefinition Width="12*"/><ColumnDefinition Width="12*"/><ColumnDefinition Width="12*"/><ColumnDefinition Width="45*"/></Grid.ColumnDefinitions>
    <Border Grid.Row="0" Grid.ColumnSpan="5" Background="{DynamicResource HeaderBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"/>
    <TextBlock Grid.Row="0" Text="Application  &#x25BE;" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" Margin="12,0" VerticalAlignment="Center"/><TextBlock Grid.Row="0" Grid.Column="1" Text="Action" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" Margin="12,0" VerticalAlignment="Center"/><TextBlock Grid.Row="0" Grid.Column="2" Text="Last activity" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" Margin="12,0" VerticalAlignment="Center"/><TextBlock Grid.Row="0" Grid.Column="3" Text="Added" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" Margin="12,0" VerticalAlignment="Center"/><TextBlock Grid.Row="0" Grid.Column="4" Text="Path" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" Margin="12,0" VerticalAlignment="Center"/>
    <ItemsControl Grid.Row="1" Grid.ColumnSpan="5" ItemsSource="{Binding Apps}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Height="29" Background="{Binding RowBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="19*"/><ColumnDefinition Width="12*"/><ColumnDefinition Width="12*"/><ColumnDefinition Width="12*"/><ColumnDefinition Width="45*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" Margin="12,0,8,0" VerticalAlignment="Center" FontWeight="Medium" TextTrimming="CharacterEllipsis"/><Border Grid.Column="1" BorderBrush="{Binding ActionBorder}" BorderThickness="1" Background="{Binding ActionBack}" CornerRadius="3" Padding="8,2" HorizontalAlignment="Left" VerticalAlignment="Center"><TextBlock Text="{Binding Action}" Foreground="{Binding ActionColor}" FontSize="10" FontWeight="Medium"/></Border><TextBlock Grid.Column="2" Text="{Binding Last}" FontFamily="Cascadia Code, Consolas" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="12,0" VerticalAlignment="Center"/><TextBlock Grid.Column="3" Text="{Binding Added}" FontFamily="Cascadia Code, Consolas" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="12,0" VerticalAlignment="Center"/><TextBlock Grid.Column="4" Text="{Binding Path}" FontFamily="Cascadia Code, Consolas" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="12,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><Border Width="3" HorizontalAlignment="Left" Margin="0,2" CornerRadius="2" Background="{DynamicResource BlueBrush}" Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibility}}"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   </Grid>
   <Border Grid.Row="4" Background="{DynamicResource TitleBarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0"><Ellipse Width="7" Height="7" Fill="{DynamicResource GreenBrush}" Margin="0,0,6,0"/><TextBlock Text="Demo preview" Foreground="{DynamicResource TextBrush}" FontSize="11" FontWeight="Medium"/><TextBlock Text="  |  Engine: Not running  |  Driver: Not installed  |  Demonstration data only" Foreground="{DynamicResource MutedBrush}" FontSize="11"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0"><TextBlock Text="1 program selected" Foreground="{DynamicResource BlueBrush}" FontSize="11" FontWeight="Medium"/><TextBlock Text="  |  Profile: " Foreground="{DynamicResource MutedBrush}" FontSize="11"/><TextBlock Text="Standard Desktop" Foreground="{DynamicResource TextBrush}" FontSize="11" FontWeight="Medium"/><Border Background="{DynamicResource BannerBrush}" BorderBrush="{DynamicResource AmberBrush}" BorderThickness="1" CornerRadius="3" Padding="7,1" Margin="10,0,0,0"><TextBlock Text="Update available" Foreground="{DynamicResource AmberBrush}" FontSize="10" FontWeight="Medium"/></Border></StackPanel></Grid></Border>
  </Grid>
 </Border>
</Window>
